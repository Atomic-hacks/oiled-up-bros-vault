generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
  OWNER
}

enum DepositStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum LedgerKind {
  DEPOSIT
  WITHDRAWAL
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String
  passwordHash  String
  role          Role      @default(MEMBER)
  goalModel     String?
  goalStorage   String?
  goalPriceKobo BigInt?
  goalDeadline  DateTime? @db.Date
  goalFrequency String?
  preferences   Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions           Session[]
  invitationsCreated Invitation[]        @relation("InvitationCreator")
  deposits           Deposit[]
  depositsReviewed   Deposit[]           @relation("DepositReviewer")
  ledgerEntries      LedgerEntry[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  devicePrice        DevicePrice?
  reconciliations    Reconciliation[]
  notifications      Notification[]
  resetCodes         PasswordResetCode[] @relation("ResetSubject")
  resetCodesCreated  PasswordResetCode[] @relation("ResetCreator")
}

model Session {
  tokenHash String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  email       String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  createdById String
  createdBy   User      @relation("InvitationCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([email, expiresAt])
}

model Deposit {
  id           String        @id @default(cuid())
  userId       String
  amountKobo   BigInt
  date         DateTime      @db.Date
  reference    String?
  note         String?
  receiptPath  String
  receiptMime  String
  fileName     String
  requestKey   String?
  status       DepositStatus @default(PENDING)
  reason       String?
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  reviewedBy   User?         @relation("DepositReviewer", fields: [reviewedById], references: [id], onDelete: Restrict)
  ledgerEntry  LedgerEntry?

  @@unique([userId, reference])
  @@unique([userId, requestKey])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([reviewedById])
}

model LedgerEntry {
  id         String     @id @default(cuid())
  userId     String
  depositId  String?    @unique
  amountKobo BigInt
  kind       LedgerKind
  note       String?
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  deposit    Deposit?   @relation(fields: [depositId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String
  action    String
  entity    String
  details   Json     @default("{}")
  createdAt DateTime @default(now())
  actor     User     @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model DevicePrice {
  userId     String   @id
  model      String
  storage    String
  amountKobo BigInt
  source     String?
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Reconciliation {
  id          BigInt   @id @default(autoincrement())
  bankKobo    BigInt
  trackedKobo BigInt
  note        String?
  actorId     String
  createdAt   DateTime @default(now())
  actor       User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model Notification {
  id        BigInt    @id @default(autoincrement())
  userId    String
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PasswordResetCode {
  id          String    @id @default(cuid())
  tokenHash   String    @unique
  userId      String
  createdById String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  user        User      @relation("ResetSubject", fields: [userId], references: [id], onDelete: Cascade)
  createdBy   User      @relation("ResetCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
}
