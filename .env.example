PORT=5173

# Supabase PostgreSQL connection strings.
DATABASE_URL=
DIRECT_URL=

# Server-only Supabase Storage credentials.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_RECEIPTS_BUCKET=vault-receipts

# Only these exact emails can register privileged accounts.
OWNER_EMAIL=
ADMIN_EMAIL=

# Generate once, put the value in .env, and enter that same value at signup.
# Remove it after both privileged accounts have registered.
BOOTSTRAP_CODE=
